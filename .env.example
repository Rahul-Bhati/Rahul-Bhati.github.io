# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Supabase Postgres (Project → Settings → Database → Connection string)
# DATABASE_URL  = pooled connection (port 6543, ?pgbouncer=true) — used at runtime
# DIRECT_URL    = direct connection (port 5432) — used for migrations
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase API (Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"   # server-only, never exposed to client

# Auth (M2) — single admin
ADMIN_EMAIL="rahul.bhati@gmail.com"
# bcrypt hash — generate with: npm run hash-password '<your-password>'
# IMPORTANT: escape each `$` as `\$` (Next loads env via dotenv-expand). The script prints the escaped line for you.
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""                  # 32+ random bytes — generate with: openssl rand -base64 48

# Analytics (M3) — optional
PAGESPEED_API_KEY=""            # Google PageSpeed Insights API key (optional; widget falls back if empty) 
# https://developers.google.com/speed/docs/insights/v5/get-started

# Site
NEXT_PUBLIC_SITE_URL="https://rahulbhati.dev"
